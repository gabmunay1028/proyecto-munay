# Copia este archivo como .env y reemplaza TU_CLAVE por la contraseña de tu usuario de PostgreSQL.
# Formato: postgresql+psycopg://USUARIO:CLAVE@SERVIDOR:PUERTO/BASE

# Base principal (la que usa la aplicación)
DATABASE_URL=postgresql+psycopg://postgres:TU_CLAVE@localhost:5432/catalogo

# Base SOLO para las pruebas automáticas (se vacía en cada prueba; nunca uses la principal)
DATABASE_URL_TEST=postgresql+psycopg://postgres:TU_CLAVE@localhost:5432/catalogo_test

# Dirección del frontend (React con Vite) autorizada a llamar a la API
FRONTEND_URL=http://localhost:5173